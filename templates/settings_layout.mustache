    Settings layout template for local_h5pthemer.

    Context variables required for this template:
    * isGlobalAdmin - (boolean) True if user is admin and global settings are visible
    * hasCustomCss - (boolean) True if custom CSS settings should be displayed
    * isReadonly - (boolean) True if custom CSS input should be readonly

    Example context (json):
    {
        "isGlobalAdmin": true,
        "hasCustomCss": true,
        "isReadonly": false
    }
}}

<div class="h5p-themer-settings-container" id="h5p-themer-settings-container">
    <div class="card h5p-themer-card mb-4">
        <div class="card-header d-flex align-items-center justify-content-between py-2 px-3">
            <h5 class="card-title mb-0 d-flex align-items-center fs-6 fw-bold">
                {{#str}} themecolors, local_h5pthemer {{/str}}
            </h5>
        </div>
        <div class="card-body p-3 p-md-4">
            <div class="h5p-themer-picker-wrapper mb-2" id="h5p-themer-picker-container">
                <!-- pickerEl will be appended here -->
            </div>
            
            {{#isGlobalAdmin}}
            <div class="h5p-themer-presets-section border-top mt-4 pt-4" id="h5p-themer-presets-container">
                <h6 class="fw-bold mb-3 d-flex align-items-center">{{#str}} saved_custom_themes, local_h5pthemer {{/str}}</h6>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3" id="h5p-themer-preset-ui">
                    <input type="text" class="form-control" style="max-width: 260px;" placeholder="{{#str}} preset_name, local_h5pthemer {{/str}}" id="h5p-themer-preset-input">
                    <button type="button" class="btn btn-secondary" id="h5p-themer-preset-save-btn">{{#str}} save_new_preset, local_h5pthemer {{/str}}</button>
                    <button type="button" class="btn btn-outline-secondary" id="h5p-themer-preset-import-btn">{{#str}} importpreset, local_h5pthemer {{/str}}</button>
                    <input type="file" accept=".json" class="d-none" id="h5p-themer-preset-file">
                </div>
                <div class="h5p-themer-presets-wrapper mt-3" id="h5p-themer-presets-list-container">
                    <!-- list will be appended here -->
                </div>
            </div>
            {{/isGlobalAdmin}}
        </div>
    </div>

    {{#hasCustomCss}}
    <div class="card h5p-themer-card mb-4">
        <div class="card-header d-flex align-items-center justify-content-between py-2 px-3">
            <h5 class="card-title mb-0 d-flex align-items-center fs-6 fw-bold">
                {{#str}} custom_css, local_h5pthemer {{/str}}
            </h5>
            {{#isReadonly}}
                <span class="badge badge-secondary bg-secondary text-white ms-auto">{{#str}} custom_css_readonly, local_h5pthemer {{/str}}</span>
            {{/isReadonly}}
            {{^isReadonly}}
                <span class="badge badge-info bg-info text-white ms-auto">{{#str}} custom_css_cumulative, local_h5pthemer {{/str}}</span>
            {{/isReadonly}}
        </div>
        <div class="card-body p-3 p-md-4">
            <p class="text-muted small mb-3">
                {{#str}} custom_css_desc, local_h5pthemer {{/str}}
            </p>
            <div class="h5p-themer-css-wrapper" id="h5p-themer-css-container">
                <!-- cssTextarea will be appended here -->
            </div>
        </div>
    </div>
    {{/hasCustomCss}}
</div>

